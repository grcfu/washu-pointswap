# Frontend (frontend/.env). Only NEXT_PUBLIC_* vars reach the browser.
# These are inlined at BUILD time, so changing them in Vercel requires a redeploy.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_your_key_here

# LEAVE THIS UNSET. The API now runs as same-origin Next.js route handlers in
# src/app/api, so page.js defaults to "/api" and needs no configuration.
#
# Only set it to run against the optional standalone FastAPI app in backend/:
#   NEXT_PUBLIC_API_URL=http://localhost:8000
#
# If this is set in Vercel it overrides the built-in routes, which is how the app
# ended up pointing at a Railway service that no longer existed.
