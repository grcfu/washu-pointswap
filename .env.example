# Root .env — only needed to run the OPTIONAL standalone FastAPI app in backend/.
# The deployed app does not use this file; its API runs as Next.js route handlers on
# Vercel and reads frontend/.env instead. See frontend/.env.example.
#
# backend/main.py calls load_dotenv("../.env"), so it must be run from backend/.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_KEY=sb_publishable_your_key_here
